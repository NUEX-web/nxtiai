GEMINI_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Phase 2 — not implemented yet. Leaving these unset keeps OpenAI/Claude
# showing as "Coming soon" in the AI model selector (see
# lib/server/model-config.ts: isProviderConfigured). No SDK for either is
# installed yet — only add one when actually wiring up its provider class.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Payments (Mollie) -- already configured in production; add locally only
# if you need to test checkout/webhook flows against Mollie's test mode.
MOLLIE_API_KEY=

# Owner alert emails (new subscriber, renewal, failed renewal -> downgrade,
# and the daily lapsed-subscription safety net). Sign up free at
# resend.com, create an API key, and set it here / in Vercel. Without
# this set, alert emails are skipped (logged only) -- nothing else breaks.
RESEND_API_KEY=
# Defaults to shaikhsameerkadeer@gmail.com if unset.
ALERTS_TO_EMAIL=
# Defaults to Resend's shared onboarding@resend.dev sender (works with no
# domain setup). Set this once a verified sending domain exists.
ALERTS_FROM_EMAIL=

# Authorizes the daily /api/cron/check-lapsed-subscriptions safety-net
# job (see vercel.json). Vercel sets the Authorization header for you
# automatically once this is set in the project's environment variables
# -- generate any long random string.
CRON_SECRET=
